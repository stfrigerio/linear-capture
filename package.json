{
  "name": "@stfrigerio/linear-capture",
  "version": "1.0.0",
  "description": "In-page visual bug reporter for Linear — point, annotate, file.",
  "main": "dist/linear-capture.js",
  "module": "dist/linear-capture.esm.js",
  "exports": {
    ".": {
      "import": "./dist/linear-capture.esm.js",
      "require": "./dist/linear-capture.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stfrigerio/linear-capture.git"
  },
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "demo": "npx serve .",
    "prepare": "node build.js",
    "release": "bash -c 'set -a && source .env && set +a && source ~/.bash_functions && pushino \"releasing new stuff\" && npm version patch && npm run build && npm publish && git push'"
  },
  "keywords": [
    "linear",
    "bug-reporter",
    "visual-feedback",
    "devtools",
    "capture",
    "screenshot"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
