{
  "name": "@stfrigerio/linear-capture",
  "version": "1.0.1",
  "description": "In-page visual bug reporter for Linear — point, annotate, file.",
  "keywords": [
    "linear",
    "bug-reporter",
    "visual-feedback",
    "devtools",
    "capture",
    "screenshot",
    "bug-report",
    "linear-app",
    "issue-tracker",
    "screenshot-annotation"
  ],
  "homepage": "https://github.com/stfrigerio/linear-capture#readme",
  "bugs": {
    "url": "https://github.com/stfrigerio/linear-capture/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stfrigerio/linear-capture.git"
  },
  "license": "MIT",
  "author": "Stefano Frigerio",
  "main": "dist/linear-capture.js",
  "module": "dist/linear-capture.esm.js",
  "exports": {
    ".": {
      "import": "./dist/linear-capture.esm.js",
      "require": "./dist/linear-capture.js"
    },
    "./queries": {
      "import": "./dist/queries.mjs",
      "require": "./dist/queries.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "demo": "npx serve . -l 4173",
    "prepare": "node build.js",
    "release": "bash -c 'set -a; [ -f .env ] && . ./.env; set +a; npm version minor && npm publish && git push --follow-tags'"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
